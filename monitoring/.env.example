WATTCOIN_PAGER_WEBHOOK_URL=https://example.com/webhook
WATTCOIN_WARNINGS_WEBHOOK_URL=https://example.com/warning
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-secure-password

# SMTP settings for email alerts
# Use your mail server / relay (e.g. smtp.zoho.com:587, smtp.gmail.com:587)
WATTCOIN_SMTP_HOST=smtp.example.com
WATTCOIN_SMTP_PORT=587
WATTCOIN_SMTP_FROM=alerts@example.com
WATTCOIN_SMTP_USER=alerts@example.com
WATTCOIN_SMTP_PASSWORD=replace-with-smtp-password

NODE_A_LEDGER_TOKEN=replace-with-node-a-token
NODE_A_SSH_PASSWORD=replace-with-node-a-ssh-password
NODE_B_LEDGER_TOKEN=replace-with-node-b-token
NODE_B_SSH_PASSWORD=replace-with-node-b-ssh-password
