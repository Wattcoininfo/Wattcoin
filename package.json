{
  "name": "wattcoin-miner",
  "version": "1.0.435",
  "description": "Wattcoin Miner — energy-backed cryptocurrency miner",
  "author": "Wattcoin",
  "license": "MIT",
  "private": true,
  "main": "electron-main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:check-source": "node scripts/check-dev-source.js",
    "monitoring:collector": "node monitoring/wattcoin-monitoring-collector.cjs",
    "monitoring:validate-config": "node monitoring/wattcoin-monitoring-collector.cjs --validate-config",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=critical",
    "lint": "eslint . --ext .js,.jsx --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .js,.jsx --ignore-path .gitignore --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,css,html}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,html}\" --ignore-path .gitignore",
    "test:ledger": "node tests/round-ledger.integration.test.js",
    "test:p2p-adversarial": "node tests/p2p-adversarial.runtime.test.js",
    "test:peer-discovery": "node tests/peer-discovery-ops.integration.test.js",
    "test:chain-corruption": "node tests/wtc-chain-corruption.test.js",
    "test:staking": "node tests/wtc-staking-queue.test.js",
    "test:lan-gate": "node tests/lan-gate.test.js",
    "test:ops-auth": "node tests/ops-auth.integration.test.js",
    "test:ops-health": "node tests/ops-health.integration.test.js",
    "test:chain-apply-rollback": "node tests/wtc-chain-apply-rollback.test.js",
    "test:mempool-risks": "node tests/wtc-mempool-risks.test.js",
    "test:readiness-probe-silence": "node tests/wtc-wallet-readiness-probe-silence.test.js",
    "test:seed-cache-corruption": "node tests/wtc-remote-seed-cache-corruption.test.js",
    "test:rpc-credentials": "node tests/wtc-rpc-credentials-empty-fallback.test.js",
    "mainnet:validate-seeds": "node scripts/validate-seed-peers.js",
    "mainnet:durability:snapshot": "node scripts/drill-snapshot-restore.js",
    "mainnet:durability:corruption": "node scripts/drill-corruption-replay.js",
    "mainnet:upgrade-gates": "npm run test:p2p-adversarial && npm run test:ledger && npm run mainnet:durability:snapshot && npm run mainnet:durability:corruption && npm run mainnet:validate-seeds",
    "mainnet:upgrade-drill": "node scripts/mainnet-upgrade-drill.js",
    "mainnet:upgrade-evidence": "node scripts/mainnet-upgrade-drill.js --capture-evidence",
    "mainnet:drills:once": "node scripts/drill-scheduler.js --once",
    "mainnet:drills:start": "node scripts/drill-scheduler.js",
    "mainnet:explain-peer-system": "node scripts/explain-peer-system.js",
    "mainnet:verify-seed-endpoint": "node scripts/verify-seed-endpoint.js",
    "mainnet:verify-peer-exchange": "node scripts/verify-peer-exchange.js",
    "native-gpu:build": "powershell -ExecutionPolicy Bypass -File native-gpu/build.ps1",
    "electron:dev": "concurrently \"vite\" \"electron electron-start.js\"",
    "electron:build": "node scripts/release-build.js",
    "electron:build:local": "node scripts/release-build.js --local",
    "deploy:whitepaper": "node scripts/_deploy-whitepaper.js",
    "deploy:seed-manifest": "node scripts/deploy-seed-manifest.js",
    "deploy:seed-registry": "node scripts/deploy-seed-registry.js",
    "deploy:elec-price-api": "node scripts/deploy-elec-price-api.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "deploy:files": "npm run sitemap && node scripts/deploy-files.js"
  },
  "dependencies": {
    "@silentbot1/nat-api": "^0.4.9",
    "electron-updater": "^6.8.3",
    "elliptic": "^6.6.1",
    "mqtt": "^5.15.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "ssh2": "^1.17.0",
    "systeminformation": "^5.31.5",
    "wasm-x11-hash": "^0.0.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "concurrently": "^8.0.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "^20.10.6",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.3.0",
    "sharp": "^0.35.3",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
