<IfModule mod_rewrite.c>
  RewriteEngine On

  # Strip index.html from URLs
  RewriteCond %{THE_REQUEST} /index\.html [NC]
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

  # Redirect legacy homepage.html → /
  RewriteCond %{THE_REQUEST} /homepage\.html [NC]
  RewriteRule ^homepage\.html$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Security headers
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Canonical for root
  <FilesMatch "^index\.html$">
    Header set Link '<https://wattcoin.ee/>; rel="canonical"'
  </FilesMatch>

  # No cache for index.html (version-sensitive content)
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Canonical for whitepaper
  <FilesMatch "wattcoin-whitepaper\.html$">
    Header set Link '<https://wattcoin.ee/wattcoin-whitepaper.html>; rel="canonical"'
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Cache static assets aggressively
  <FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|webp|css|js|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cache webmanifest
  <FilesMatch "site\.webmanifest$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  # Compress HTML, CSS, JS, JSON, XML, SVG
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Custom 404 page
ErrorDocument 404 /index.html
